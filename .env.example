MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=

OPENVIDU_URL=
OPENVIDU_SECRET=
OPENVIDU_WEBHOOK_SECRET=
INTERNAL_API_SECRET=

AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

JWT_SECRET=

MAIL_USERNAME=
MAIL_PASSWORD=

ODSAY_API_KEY=

# GMS 상담 요약 모델 연동
GMS_API_KEY=

# Azure Speech — 화상 상담 실시간 번역 자막 (ai 컨테이너)
# 지역은 비밀이 아니므로 채워 둔다. 키만 각자 넣으면 된다.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# 표지판 사진을 S3 에 새로 올릴 때마다 숫자를 하나씩 올리고 api 컨테이너를
# 재기동한다. 프론트 서비스워커가 사진 URL 을 30일 CacheFirst 로 캐싱해서,
# 파일명이 같으면 새 사진을 올려도 이미 캐시를 가진 사용자에겐 안 바뀐다 —
# 이 값이 바뀌면 URL 의 ?v= 쿼리스트링이 달라져 캐시가 강제로 무효화된다.
SIGN_IMAGE_VERSION=1