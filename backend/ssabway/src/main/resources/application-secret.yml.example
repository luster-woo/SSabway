# 이 파일을 application-secret.yml 로 복사한 뒤 값을 채우세요. (로컬 전용, gitignore)
# Docker 실행 시엔 이 파일 대신 루트 .env 가 사용됩니다.
# 키 이름은 .env / application.yml 의 ${...} placeholder 와 동일하게 유지하세요.

JWT_SECRET: ""
MAIL_USERNAME: ""
MAIL_PASSWORD: ""

# 로컬 MySQL 이 기본값(root/localonly/localhost)과 다를 때만 주석 해제해 덮어쓰기
# SPRING_DATASOURCE_URL: jdbc:mysql://localhost:3306/ssabway_db
# SPRING_DATASOURCE_USERNAME: root
# SPRING_DATASOURCE_PASSWORD: localonly
# SPRING_DATA_REDIS_HOST: localhost

AWS_ACCESS_KEY_ID: ""
AWS_SECRET_ACCESS_KEY: ""
AWS_S3_BUCKET: ""
# AWS_REGION: ap-northeast-2   # 서울 외 리전 쓸 때만 주석 해제
